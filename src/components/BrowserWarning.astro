---
/**
 * Full-screen notice for very old Internet Explorer (version 8 and below).
 * Hidden by CSS; the classic inline scripts below decide whether to show it.
 * They stay inline and un-bundled on purpose: the browsers they target cannot
 * run the modern JavaScript the rest of the site ships.
 */
---

<!-- START BROWSER MESSAGE  -->
<div id="life-is-short" class="modal modal--browser-warning">
  <div class="modal__content">
    <div class="section section--light">
      <div class="section__content">
        <span id="close-modal-button" class="modal__close-button" onclick="closeModal('life-is-short')">&times;</span>
        <h1 class="h1-heading">Looks like you're using an outdated browser</h1>
        <p>You can proceed and visit my my site, but some of the layout and functionality may not work as intended.</p>
        <a class="link link--on-light-bg" href="#" onclick="closeModal('life-is-short')">I like pain, show me your site</a>
      </div>
      <div class="section section--light">
        <div class="section__content section--first-in-section section--last-in-section">
          <h2 class="h2-heading">Want a better browser?</h2>
          <p>Chances are, you spend a good proportion of your life on the internet. Make the most of it – get a modern browser.</p>
          <a class="link link--on-light-bg" target="_blank" href="http://www.browsehappy.com/">Learn about modern browsers</a>
        </div>
      </div>
    </div>
  </div>
</div>
<script is:inline>
  // Called from the onclick handlers above.
  // eslint-disable-next-line no-unused-vars
  function closeModal(modalID) {
    document.getElementById(modalID).style.display = 'none';
  }
  (function () {
    var ua = window.navigator.userAgent;
    var version = false;
    var msie = ua.indexOf('MSIE ');
    var trident = ua.indexOf('Trident/');
    var edge = ua.indexOf('Edge/');
    if (msie > 0) {
      version = parseInt(ua.substring(msie + 5, ua.indexOf('.', msie)), 10);
    } else if (trident > 0) {
      var rv = ua.indexOf('rv:');
      version = parseInt(ua.substring(rv + 3, ua.indexOf('.', rv)), 10);
    } else if (edge > 0) {
      version = parseInt(ua.substring(edge + 5, ua.indexOf('.', edge)), 10);
    }
    var modal = document.getElementById('life-is-short');
    if (version === false) {
      modal.style.display = 'none';
    } else if (version < 9) {
      modal.style.display = 'block';
    }
  })();
</script>
<!-- END BROWSER MESSAGE  -->
